#include <windows.h>
#include "../nav_version.h"
1 RT_MANIFEST "windows.manifest"
1 VERSIONINFO
FILEVERSION NAVALM_VERSION_WINDOWS
PRODUCTVERSION NAVALM_VERSION_WINDOWS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "NAVALM Navigation Workbench\0"
      VALUE "ProductName", "NAVALM\0"
      VALUE "ProductVersion", NAVALM_VERSION "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
